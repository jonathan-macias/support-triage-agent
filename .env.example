# Copia este archivo a .env y ajusta los valores si hace falta.
DATABASE_URL=postgresql+pg8000://tickets:tickets@localhost:5433/tickets

# Modelo de IA ("proveedor:modelo"). Alternativa más potente: google:gemini-3.8-flash
AI_MODEL=google:gemini-3.5-flash-lite
# Consigue tu key en https://aistudio.google.com/apikey  (nunca la subas a git)
GOOGLE_API_KEY=
