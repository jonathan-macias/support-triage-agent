# Copy to .env and adjust as needed.
DATABASE_URL=postgresql+pg8000://tickets:tickets@localhost:5433/tickets

# AI model as "provider:model". More capable alternative: google:gemini-3.8-flash
AI_MODEL=google:gemini-3.5-flash-lite
# Get a key at https://aistudio.google.com/apikey (never commit it)
GOOGLE_API_KEY=
